#!/usr/bin/env bash
# Prints one word for a folder: ready, not-a-repo, exempt, unknown-owner, or not-set-up:<reason>
# where reason is no-org-plugin (the repo owner's warren plugin isn't installed) or disabled
# (installed but not enabled). Advisory: it always exits 0 for a status.
#
# A repo's rules come from its GitHub owner's plugin (warren-org-<name>, or a personal one), which
# lives in the owner's marketplace and is enabled at user level; they are not inside the repo. The
# repo's own .claude/settings.json holds only that repo's overrides, so a repo with no plugin list
# is normal. The owner comes from the origin remote; the owner's marketplace key is its lowercase.
#   warren-repo-ready [dir]        default dir is $PWD
# WARREN_EXEMPT        colon-separated folders to skip (default none)
# CLAUDE_CONFIG_DIR    where installed_plugins.json and the user settings live (default $HOME/.claude)
set -uo pipefail
dir=${1:-$PWD}
dir=$(cd "$dir" 2>/dev/null && pwd -P) || { echo not-a-repo; exit 0; }

IFS=: read -r -a exempt <<<"${WARREN_EXEMPT-}"
for e in "${exempt[@]}"; do
  [ -n "$e" ] || continue
  e=$(cd "$e" 2>/dev/null && pwd -P) || continue
  case "$dir/" in "$e"/*) echo exempt; exit 0 ;; esac
done

top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || { echo not-a-repo; exit 0; }

# Owner from the origin remote (or the first remote), github.com only.
remote=$(git -C "$top" remote get-url origin 2>/dev/null) \
  || remote=$(git -C "$top" remote get-url "$(git -C "$top" remote 2>/dev/null | head -n 1)" 2>/dev/null) \
  || remote=""
owner=""
if [[ "$remote" =~ github\.com[:/]+([^/]+)/ ]]; then
  owner=$(printf '%s' "${BASH_REMATCH[1]}" | tr '[:upper:]' '[:lower:]')
fi
[ -n "$owner" ] || { echo unknown-owner; exit 0; }

cfg="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
list="$cfg/plugins/installed_plugins.json"
keys=""
if [ -f "$list" ]; then
  keys=$(jq -r --arg o "@$owner" '(.plugins // {}) | keys[] | select(startswith("warren-") and endswith($o))' "$list" 2>/dev/null)
fi
[ -n "$keys" ] || { echo not-set-up:no-org-plugin; exit 0; }

# Enabled at user level, or by the repo; a later layer wins.
files=()
for f in "$cfg/settings.json" "$top/.claude/settings.json" "$top/.claude/settings.local.json"; do
  [ -f "$f" ] && files+=("$f")
done
enabled=""
if [ "${#files[@]}" -gt 0 ]; then
  enabled=$(jq -s -r '
    map(select(type == "object" and (.enabledPlugins | type) == "object") | .enabledPlugins)
    | add // {} | to_entries[] | select(.value == true) | .key' "${files[@]}" 2>/dev/null)
fi
while IFS= read -r key; do
  if printf '%s\n' "$enabled" | grep -qxF -- "$key"; then echo ready; exit 0; fi
done <<<"$keys"
echo not-set-up:disabled
