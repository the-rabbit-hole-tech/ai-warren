{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "f=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-ai-tells.sh\"; [ -f \"$f\" ] || exit 0; exec bash \"$f\"" },
          { "type": "command", "command": "f=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/validate-conventional-commit.sh\"; [ -f \"$f\" ] || exit 0; exec bash \"$f\"" },
          { "type": "command", "command": "f=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-push-readiness.sh\"; [ -f \"$f\" ] || exit 0; exec bash \"$f\"" }
        ]
      }
    ]
  }
}
